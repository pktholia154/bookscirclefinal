rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Books catalog - public read and sync
    match /books/{bookId} {
      allow read, write: if true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Users collection & subcollections (e.g., users/{userId}/purchases/{purchaseId})
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Purchases & Order transactions
    match /purchases/{purchaseId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /book_analytics/{bookId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
